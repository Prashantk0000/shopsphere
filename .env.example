# ShopSphere Environment Variables Reference
SECRET_KEY=your-custom-production-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app
# Leave blank to use SQLite by default, or provide PostgreSQL URL:
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Razorpay Payment Gateway Credentials (Optional - Mock Sandbox used if left empty)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Stripe Payment Gateway Credentials (Optional - Mock Sandbox used if left empty)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Mailbox Notification Settings (Console backend used by default in DEBUG)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL="ShopSphere Store <noreply@shopsphere.com>"

